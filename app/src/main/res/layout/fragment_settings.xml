<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Subtitle speech"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Speech rate"
                android:textColor="@color/text" />
            <TextView
                android:id="@+id/rateVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text2" />
        </LinearLayout>
        <SeekBar
            android:id="@+id/rateBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pitch"
                android:textColor="@color/text" />
            <TextView
                android:id="@+id/pitchVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text2" />
        </LinearLayout>
        <SeekBar
            android:id="@+id/pitchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Changing rate or pitch generates a new audio track the next time you pick a subtitle. The voice and language come from your system text-to-speech engine."
            android:textColor="@color/text2"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnTtsSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="System text-to-speech settings" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Overlapping subtitles"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">
        <RadioButton
            android:id="@+id/modeOverlap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Overlap"
            android:textColor="@color/text" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="8dp"
            android:text="Every line plays at its exact start time, even if another line is still speaking."
            android:textColor="@color/text2"
            android:textSize="12sp" />
        <RadioButton
            android:id="@+id/modeSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skip overlaps"
            android:textColor="@color/text" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="8dp"
            android:text="Never two voices at once. A line that would start while another is still speaking is dropped."
            android:textColor="@color/text2"
            android:textSize="12sp" />
        <RadioButton
            android:id="@+id/modeHybrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hybrid (recommended)"
            android:textColor="@color/text" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="8dp"
            android:text="No overlap. Speech is sped up (up to 2x) to stay in sync. Overlapping lines are sped up together to fit their combined time window."
            android:textColor="@color/text2"
            android:textSize="12sp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Applies the next time you open a video or play a track. No need to regenerate audio."
            android:textColor="@color/text2"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Storage"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Each subtitle line is saved as its own small audio file in the app's Music folder (Android/data/com.openmedia.app/files/Music/Subtitle TTS) and listed in the Music tab. Long-press a track there to delete it."
            android:textColor="@color/text2"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Open Media 1.0"
            android:textColor="@color/text2"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
